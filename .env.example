# ---- Supabase (Settings -> API) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by cron routes only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://communityday.awssbg.ca

# ---- Access control -------------------------------------------------------
# Comma-separated email domains allowed to sign in. Leave blank to allow any
# Google account to reach the login screen (they still land as 'pending' with
# zero access until an owner promotes them).
ALLOWED_EMAIL_DOMAINS=sheridancollege.ca,sheridanc.on.ca

# ---- Cron protection (any long random string) -------------------------------
CRON_SECRET=change-me-to-something-random

# ---- Optional: Luma registration count sync ---------------------------------
LUMA_API_KEY=
LUMA_EVENT_ID=
