# ---------------------------------------------------------------------------
# LIVE VALUES for the club's Supabase project (ssuzhrvdtpakzbwsvlch, ca-central-1)
# Copy this file to .env.local. Safe to commit? No — .env.local is gitignored.
#
# The two NEXT_PUBLIC_ values are designed to be public: row-level security is
# what protects the data, and the anon key can only ever read rows whose
# status = 'published'.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ssuzhrvdtpakzbwsvlch.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzdXpocnZkdHBha3pid3N2bGNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0OTMyMzAsImV4cCI6MjEwMzA2OTIzMH0.Ms8IOJp4xB67f6xZAOhrJajLCoUlLUGzMkxjFk54QrE

# ---------------------------------------------------------------------------
# SERVER ONLY — bypasses row-level security entirely.
# Get it from: Supabase -> Settings -> API -> service_role (reveal)
# Paste it here locally and add it in Vercel. Never commit it, never prefix it
# with NEXT_PUBLIC_, never paste it into a chat.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated domains allowed to sign in. Everyone still lands as 'pending'.
ALLOWED_EMAIL_DOMAINS=

# Any long random string. Protects the two cron routes.
CRON_SECRET=

# Optional: live registration count
LUMA_API_KEY=
LUMA_EVENT_ID=
